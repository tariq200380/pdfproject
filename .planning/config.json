{
  "version": "2.0",
  "project_name": "OmniMedia & PDF Studio",
  "architecture": "Stateless (No Database, No Auth)",
  "stack": {
    "frontend": "Next.js (React, TypeScript, CSS Modules / Custom Tokens)",
    "backend": "Python FastAPI (Uvicorn)",
    "pdf_engine": "PyMuPDF (fitz) / fonttools / pdfplumber",
    "media_engine": "FFmpeg (Audio/Video transcoding & CRF compression)",
    "image_engine": "Pillow / Pillow-HEIF / libvips",
    "client_storage": "Browser IndexedDB (Auto-recovery with 2-4h TTL)"
  },
  "workflow": {
    "tracer_first": true,
    "verify_each_step": true
  }
}
